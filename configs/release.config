CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
# UPNP is not compiled into the image
# CONFIG_PACKAGE_luci-app-upnp is not set
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# FakeHTTP: NFQUEUE verdicts via nftables
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nft-queue=y
# Built into the sysupgrade image
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bird3=y
CONFIG_PACKAGE_bird3c=y
CONFIG_PACKAGE_bird3cl=y

# SSH tunnel (sshtunnel-nn fork: backend + LuCI app + zh-cn i18n)
CONFIG_PACKAGE_sshtunnel-nn=y
CONFIG_PACKAGE_luci-app-sshtunnel-nn=y
CONFIG_PACKAGE_luci-i18n-sshtunnel-nn-zh-cn=y

# ZMODEM file transfer helpers (rz / sz) for serial and SSH sessions
CONFIG_PACKAGE_lrzsz=y

# CPU frequency scaling (backend + LuCI app + zh-cn i18n)
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
